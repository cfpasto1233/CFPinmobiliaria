# =============================================================================
# CFPASTO — Variables de entorno
# =============================================================================
# Copia este archivo como .env y ajusta los valores indicados.
# Nunca subas .env al repositorio — está en .gitignore.
# IMPORTANTE: no uses comentarios inline (# ...) después de valores,
#             pydantic-settings no los admite y fallará al parsear.
#
# Para generar SECRET_KEY segura:
#   Linux/Mac:  openssl rand -hex 32
#   PowerShell: -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 48 | ForEach-Object {[char]$_})
# =============================================================================


# ─── Docker ──────────────────────────────────────────────────────────────────
# Nombres de imagen y stack. En local dejar como está.
DOCKER_IMAGE_BACKEND=cfpasto-backend
DOCKER_IMAGE_FRONTEND=cfpasto-frontend
TAG=latest
STACK_NAME=cfpasto
DOMAIN=localhost


# ─── Entorno ─────────────────────────────────────────────────────────────────
# Valores posibles: local | staging | production
# En producción deshabilita /docs, /redoc y el schema OpenAPI público.
ENVIRONMENT=local


# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# En Docker local el servidor es el nombre del servicio "db".
# En Railway usar las variables de referencia: ${{Postgres.PGHOST}}, etc.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# CAMBIAR: contraseña de la base de datos
POSTGRES_PASSWORD=changethis
POSTGRES_DB=app


# ─── Backend — Seguridad ─────────────────────────────────────────────────────
PROJECT_NAME=Cfpasto
# CAMBIAR: generar con "openssl rand -hex 32" (mínimo 32 chars)
SECRET_KEY=changethis-genera-uno-con-openssl-rand-hex-32

# Tiempos de vida de los tokens JWT (en minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# 10080 = 60 * 24 * 7 = 7 días
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Superusuario creado automáticamente al iniciar por primera vez
# CAMBIAR: usar email y contraseña seguros
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis


# ─── URLs y CORS ─────────────────────────────────────────────────────────────
# FRONTEND_HOST: URL del frontend (usada en emails y redirects del backend)
# BACKEND_CORS_ORIGINS: lista separada por comas de orígenes permitidos
FRONTEND_HOST=http://localhost:4200
BACKEND_URL=http://localhost:8000
BACKEND_CORS_ORIGINS=http://localhost:4200,http://localhost:80,http://127.0.0.1:4200

# Producción (ejemplo):
# FRONTEND_HOST=https://cfpasto.com
# BACKEND_CORS_ORIGINS=https://cfpasto.com,https://www.cfpasto.com


# ─── SMTP ────────────────────────────────────────────────────────────────────
# Local: usa Mailcatcher (captura emails sin enviarlos, ver http://localhost:1080)
# Producción: usar Gmail con App Password u otro proveedor SMTP
SMTP_HOST=mailcatcher
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=
SMTP_PASSWORD=

EMAILS_FROM_EMAIL=noreply@cfpasto.com
EMAILS_FROM_NAME=Cfpasto

# Producción (ejemplo con Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# EMAILS_FROM_EMAIL=tu-cuenta@gmail.com
# EMAILS_FROM_NAME=Cfpasto


# ─── MinIO (almacenamiento de archivos S3-compatible) ────────────────────────
# STORAGE_BACKEND: local | minio | s3
#   - local: guarda en filesystem del contenedor (dev; datos se pierden en redeploy)
#   - minio: usa MinIO en Docker (dev/staging)
#   - s3: usa AWS S3 o Cloudflare R2 (producción)
STORAGE_BACKEND=minio
# Host interno Docker. En producción: dominio R2/S3
MINIO_ENDPOINT=minio:9000
# URL accesible desde el navegador para armar los links públicos a archivos (fotos de propiedades, etc).
# En producción: dominio público del bucket/CDN.
MINIO_PUBLIC_URL=http://localhost:9100
MINIO_ROOT_USER=minioadmin
# CAMBIAR
MINIO_ROOT_PASSWORD=changethis
MINIO_BUCKET=cfpasto
# false en local (HTTP), true en producción (HTTPS)
MINIO_SECURE=false


# ─── Redis ───────────────────────────────────────────────────────────────────
# En Docker local el host es el nombre del servicio "redis".
# En Railway usar: ${{Redis.REDISHOST}}, ${{Redis.REDISPORT}}, ${{Redis.REDISPASSWORD}}
REDIS_HOST=redis
REDIS_PORT=6379
# CAMBIAR: debe coincidir con --requirepass en compose.yml
REDIS_PASSWORD=changeme
REDIS_DB=0


# ─── Sentry (monitoreo de errores en producción) ─────────────────────────────
# Dejar vacío en local — solo activa si ENVIRONMENT != "local".
SENTRY_DSN=


# ─── Traefik producción (solo si se despliega self-hosted con compose.traefik.yml) ──
# No se usa en el camino Railway + Vercel documentado en docs/DEPLOY_VERCEL_RAILWAY.md.
# EMAIL: para el resolver ACME/Let's Encrypt.
# USERNAME / HASHED_PASSWORD: basic-auth del dashboard de Traefik (generar hash con: openssl passwd -apr1)
EMAIL=
USERNAME=
HASHED_PASSWORD=
